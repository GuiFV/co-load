# Environment for the bundled docker-compose vLLM service, plus secrets.
# Copy to .env (gitignored); docker compose reads it automatically from the
# repo root. Every value here is optional: the compose defaults stand in.

# Needed only for gated/private Hugging Face models served via vLLM.
HUGGING_FACE_HUB_TOKEN=

# Host port for the vLLM container (default 8000). Set this when something
# else already owns 8000. It must agree with engines.vllm.base_url in your
# config, or coload health-checks a port nothing is listening on and reports
# a timeout that looks like a broken engine.
COLOAD_VLLM_PORT=

# Set to 1 only under Docker Desktop on Windows, where containers run inside
# WSL2 and vLLM disables pinned memory by default; its v1 GPU worker then
# dies with "UVA is not available". The default is conservative rather than a
# hard limit, so verify first: run torch.zeros(n, pin_memory=True) on the GPU
# inside this image, and leave this unset if it fails.
VLLM_WSL2_ENABLE_PIN_MEMORY=

# Extra flags appended to the vLLM command, e.g. "--max-model-len 16384".
# These land after the ones coload passes, and vLLM keeps the last value of a
# repeated flag, so putting --gpu-memory-utilization here overrides the
# budget coload computed for the load.
COLOAD_VLLM_EXTRA_ARGS=
